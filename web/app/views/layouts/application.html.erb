<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Summorization" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%# Apply the saved theme before the stylesheet paints, to avoid a light flash. %>
    <%= javascript_tag nonce: true do %>
      const theme = localStorage.getItem("theme"); if (theme) document.documentElement.dataset.theme = theme;
    <% end %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-fake-services="<%= Services.fake? %>">
    <header class="topbar">
      <%= link_to "Summorization", root_path, class: "brand" %>
      <nav data-controller="theme">
        <%= link_to "History", summaries_path %>
        <button type="button" class="theme-toggle" data-action="theme#toggle" aria-label="Toggle dark theme">
          <span data-theme-target="label"></span>
        </button>
      </nav>
    </header>
    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
