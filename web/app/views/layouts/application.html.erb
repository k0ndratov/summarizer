<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Summorization" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <%= link_to "Summorization", root_path, class: "brand" %>
      <nav><%= link_to "History", summaries_path %></nav>
    </header>
    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
